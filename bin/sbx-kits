#!/usr/bin/env bash
# sbx-kits -- compose and drive a sandbox built from the kits in this repo.
#
# WHY THIS EXISTS.  The raw invocation is a dozen arguments, and three of them
# must be BYTE-IDENTICAL to two others:
#
#   sbx run --detached claude --name burpbox . \
#     ~/.sbx/burp/dist:ro \
#     --kit .../kits/jupyter --kit .../kits/desktop --kit .../kits/burp \
#     --kit-arg sbx-burp.dist=~/.sbx/burp/dist \
#     -m 8g -p 8888:8888 -p 6080:6080 -p 18080:8080
#
# The duplication is not gratuitous -- an additional workspace mounts at its
# identical host path and a kit cannot read the mount table, so the path has to
# be told to the kit separately.  But it is exactly the kind of thing a human
# gets wrong at 1am, and it fails late and unhelpfully when they do.  Composing
# it here makes the mismatch impossible by construction.
#
# It also owns the two things no kit can own:
#
#   THE SHARED TOKEN.  /home/agent/.sbx-token is container overlay, so a kit
#   letting the sandbox generate its own means (a) the only way to learn it is
#   to exec into a sandbox that already exists, because `sbx run` surfaces no
#   install or startup output, and (b) a `sbx kit add` container swap silently
#   regenerates it and changes the noVNC password and JupyterLab token
#   underneath you.  Generated here, pinned with --kit-arg, printed at create.
#
#   HOST PORTS.  A kit-declared port is auto-published, but only on an ephemeral
#   host port that is REALLOCATED ON RESTART (measured: 49166/67/68 became
#   49169/70/71 after one stop/start, old numbers dead).  So fixed -p mappings
#   are what make a bookmark work, and picking them has to cope with the fact
#   that anyone using the burp kit already has a Burp on 8080.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/sbx-kits"

# Defaults, overridable per-invocation or from the config file below.
NAME=""
WORKSPACE="$PWD"
KITS="jupyter,desktop,browser,burp"
BURP_ROOT="$HOME/.sbx/burp"
MEMORY="8g"
CPUS=""
# Empty means "whatever kits/jupyter/spec.yaml defaults to", which is the PyPI
# release. Set it to a SHA-pinned git+https URL to run a fork; the config file
# is the place for that, since a fork you are living on is not a per-invocation
# decision.
JUPYTER_MCP_PKG=""
# Empty means the sbx-burp kit's own defaults: the node half built from
# upstream's source at the pinned ref. BURP_MCP_SRC must match the coordinate
# that staged the extension jar; BURP_MCP_PKG is the npm spelling for the day
# upstream publishes, and wins over BURP_MCP_SRC when set.
BURP_MCP_SRC=""
BURP_MCP_PKG=""
# Empty means "whatever kits/browser/spec.yaml pins", which is a released
# @playwright/mcp. Note this one choice fixes the BROWSER too: the package pins
# an exact playwright, and the Chromium downloaded at create is the revision
# that playwright names.
PLAYWRIGHT_MCP_PKG=""
PORT_JUPYTER=8888
PORT_NOVNC=6080
PORT_BURP=18080          # host side; the sandbox listener is always 8080
# Kit groups: a name in --kits that is not a kit expands to its group, so
# `--kits pentest,foo` works.  One level: a group lists kits, not groups.
# Define your own in the config file below, e.g. KIT_GROUP_nb=jupyter,opencode
KIT_GROUP_pentest="jupyter,desktop,browser,burp,opencode,skycell"

# ~/.config/sbx-kits/config is sourced if present: plain KEY=value bash, so
# `MEMORY=12g` or `KITS=jupyter,desktop` there beats retyping flags.
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/sbx-kits/config"
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && . "$CONFIG"

die() { echo "sbx-kits: $*" >&2; exit 1; }

usage() {
    cat <<EOF
Usage: sbx-kits <command> [NAME] [options]

Commands:
  up [NAME]        Create the sandbox and print its URLs
  urls [NAME]      Print the URLs and token again
  status [NAME]    Sandbox state, published ports, and per-service health
  shell [NAME]     Interactive shell inside the sandbox
  burp [NAME]      Start Burp, attached to this terminal (first run needs it)
  svcs [NAME]      Start the supervised services that are not running
  wake [NAME]      Start a stopped sandbox and its services, without the Claude TUI
  skycell [NAME]   (Re)connect the sandbox to the skycell: after the cell, its
                   port or its model changed, or when none was up at 'up'
  down [NAME]      Stop the sandbox
  destroy [NAME]   Remove the sandbox AND everything Burp wrote in it

Options (for 'up'):
  --workspace DIR    Project directory to mount    (default: \$PWD)
  --kits LIST        Comma-separated kits and groups (default: $KITS)
  --burp-root DIR    Burp staging root            (default: $BURP_ROOT)
  --memory SIZE      Sandbox memory               (default: $MEMORY)
  --cpus N           Sandbox CPUs                 (default: sbx's own)
  --token STRING     Pin the shared token         (default: generate and keep)
  --jupyter-mcp-pkg REQ  jupyter-mcp-server source (default: the PyPI release)
  --burp-mcp-src OWNER/REPO@REF
                     Burp MCP server source; match stage-burp.sh --burp-mcp-src
  --burp-mcp-pkg SPEC    Burp MCP server as an npm spec (wins over --burp-mcp-src)
  --playwright-mcp-pkg SPEC  Playwright MCP server npm spec (default: the pinned release)
  --dry-run          Print the sbx command instead of running it

Kit groups: $(set | sed -n 's/^KIT_GROUP_\([A-Za-z0-9_]*\)=/  \1 = /p' | tr -d "'")

NAME defaults to the sandbox mounting $PWD (for 'up': the directory name).
Config file: $CONFIG
skycell: reads \${SKYCELL_EXPORT:-~/.config/skycell}, as the control center writes it.
EOF
}

# --- argument parsing ------------------------------------------------------
CMD="${1:-}"; [ $# -gt 0 ] && shift || true
case "$CMD" in
    ""|-h|--help|help) usage; exit 0 ;;
esac
# A bare first argument that is not a flag is the sandbox name.
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then NAME="$1"; shift; fi

TOKEN=""
DRY_RUN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --workspace) WORKSPACE="${2:?}"; shift 2 ;;
        --kits) KITS="${2:?}"; shift 2 ;;
        --burp-root) BURP_ROOT="${2:?}"; shift 2 ;;
        --memory|-m) MEMORY="${2:?}"; shift 2 ;;
        --cpus) CPUS="${2:?}"; shift 2 ;;
        --token) TOKEN="${2:?}"; shift 2 ;;
        --jupyter-mcp-pkg) JUPYTER_MCP_PKG="${2:?}"; shift 2 ;;
        --burp-mcp-src) BURP_MCP_SRC="${2:?}"; shift 2 ;;
        --burp-mcp-pkg) BURP_MCP_PKG="${2:?}"; shift 2 ;;
        --playwright-mcp-pkg) PLAYWRIGHT_MCP_PKG="${2:?}"; shift 2 ;;
        --dry-run) DRY_RUN=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

WORKSPACE="$(cd "$WORKSPACE" 2>/dev/null && pwd)" || die "no such directory: $WORKSPACE"

# --- kit groups --------------------------------------------------------------
# Expanded once, here, so everything below -- has_kit included -- sees kits
# only.  In place rather than echoed: a die inside $(...) would only leave the
# subshell.  Order is kept and repeats dropped, so a group plus one of its own
# kits does not pass --kit twice.
expand_kits() {
    local out="," k g members m
    for k in ${KITS//,/ }; do
        if [ -d "$REPO/kits/$k" ]; then
            members="$k"
        else
            case "$k" in *[!A-Za-z0-9_]*) die "no kit or group named '$k'" ;; esac
            g="KIT_GROUP_$k"
            members="${!g:-}"
            [ -n "$members" ] || die "no kit or group named '$k' -- kits: $(ls "$REPO/kits" | tr '\n' ' ')"
        fi
        for m in ${members//,/ }; do
            [ -d "$REPO/kits/$m" ] || die "group '$k' lists '$m', which is not a kit (groups do not nest)"
            case "$out" in *",$m,"*) ;; *) out="$out$m," ;; esac
        done
    done
    out="${out#,}"; KITS="${out%,}"
}
expand_kits

# --- finding the sandbox ---------------------------------------------------
# WITHOUT A NAME, RESOLVE BY WORKSPACE, NOT BY DIRECTORY NAME.  Guessing
# basename($PWD) looks reasonable and is wrong the moment a sandbox is named
# anything else -- `status` in a repo called jlab-mcp-sbx then filtered for a
# sandbox of that name, found none, and printed a bare table header. Matching on
# the mounted workspace answers the question actually being asked: "the sandbox
# for this directory".  basename is the fallback for `up`, which is naming a
# sandbox that does not exist yet.
sbx_json() { sbx ls --json 2>/dev/null || echo '{"sandboxes":[]}'; }

sandbox_names() {
    sbx_json | python3 -c 'import json,sys
for s in json.load(sys.stdin).get("sandboxes", []): print(s["name"])'
}

names_for_workspace() {
    sbx_json | python3 -c 'import json,sys
ws = sys.argv[1]
for s in json.load(sys.stdin).get("sandboxes", []):
    for w in s.get("workspaces", []):
        if (w[:-3] if w.endswith(":ro") else w) == ws:
            print(s["name"]); break' "$1"
}

if [ -z "$NAME" ]; then
    matches="$(names_for_workspace "$WORKSPACE")"
    count=$(printf '%s\n' "$matches" | grep -c . || true)
    case "$count" in
        1) NAME="$matches" ;;
        0) NAME="$(basename "$WORKSPACE")" ;;
        *) die "several sandboxes mount $WORKSPACE:
$(printf '%s\n' "$matches" | sed 's/^/    /')
  Name the one you mean." ;;
    esac
fi

sandbox_exists() { sandbox_names | grep -qx "$NAME"; }

require_sandbox() {
    sandbox_exists && return 0
    local all; all="$(sandbox_names)"
    if [ -z "$all" ]; then
        die "no sandbox named '$NAME', and none exist. Create one: sbx-kits up"
    fi
    die "no sandbox named '$NAME'. Existing sandboxes:
$(printf '%s\n' "$all" | sed 's/^/    /')
  Name one, or run sbx-kits up to create '$NAME'."
}

has_kit() { case ",$KITS," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
# The kits that read the shared token and publish a port.  `sbx run` refuses a
# --kit-arg that no kit in the composition declares, so a sandbox of only
# kits/opencode must not be handed one.
has_token_kit() { has_kit jupyter || has_kit desktop || has_kit burp; }

# --- the shared token ------------------------------------------------------
# Kept per sandbox name, on the host, so `urls` can answer without execing into
# anything and so a recreate reuses the same value.
TOKEN_FILE="$STATE_HOME/$NAME.token"
load_token() {
    if [ -n "$TOKEN" ]; then
        mkdir -p "$STATE_HOME"; printf '%s\n' "$TOKEN" > "$TOKEN_FILE"
    elif [ -s "$TOKEN_FILE" ]; then
        TOKEN="$(cat "$TOKEN_FILE")"
    else
        mkdir -p "$STATE_HOME"
        TOKEN="$(head -c 18 /dev/urandom | base64 | tr -d '/+=')"
        printf '%s\n' "$TOKEN" > "$TOKEN_FILE"
    fi
    chmod 600 "$TOKEN_FILE"
}

# --- host port selection ---------------------------------------------------
# `sbx run` fails the WHOLE create with a 409 when a host port is taken -- it
# does not fall back -- so shift off a busy port here rather than 12 arguments
# later.  Measured: your own Burp on 127.0.0.1:8080 kills the create outright.
port_busy() { timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null; }
pick_port() {
    local want=$1 p=$1 n=0
    while port_busy "$p"; do
        n=$((n + 1)); p=$((want + n * 1000))
        [ "$n" -gt 20 ] && die "no free host port near $want"
    done
    [ "$p" != "$want" ] && echo "sbx-kits: host port $want is busy; using $p" >&2
    echo "$p"
}

print_urls() {
    has_token_kit || return 0
    load_token
    echo
    has_kit desktop && echo "  noVNC       http://127.0.0.1:$PORT_NOVNC/vnc.html?resize=remote   password: $(printf '%s' "$TOKEN" | cut -c1-8)"
    has_kit jupyter && echo "  JupyterLab  http://127.0.0.1:$PORT_JUPYTER/lab?token=$TOKEN"
    has_kit burp && echo "  Burp proxy  127.0.0.1:$PORT_BURP  (sandbox-side listener is 8080)"
    has_kit desktop || return 0
    cat <<EOF

The VNC password is the FIRST 8 CHARACTERS only -- the RFB protocol truncates it
and throws the rest away, which is why these are bound to 127.0.0.1 and nowhere
else.  resize=remote on the noVNC URL is what makes the desktop follow the
browser window instead of being scaled to fit it.
EOF
}

# --- per-service health ----------------------------------------------------
# Shared by `status` and `svcs` so that the table printed after a start is the
# same table `status` prints, probed the same way.  THE PORT IS THE AUTHORITY,
# not the process table: desktop-svc.sh keeps three processes alive and a live
# supervisor with a dead websockify still serves the noVNC page, so "is the
# supervisor running" is a different question from "does the service work".
# Both questions get asked -- this one here, the other in start_services.
health() {
    sbx exec "$NAME" bash -lc '
        for p in 8888:jupyterlab 6080:novnc 5900:xvnc 8080:burp-proxy 8081:burp-mcp; do
            port=${p%%:*}; name=${p##*:}
            if timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null; then
                printf "  %-12s %-5s up\n" "$name" "$port"
            else
                printf "  %-12s %-5s down\n" "$name" "$port"
            fi
        done
        # The skycell, probed the way opencode reaches it: through the proxy,
        # with the placeholder the proxy swaps for the key.
        f=$HOME/.config/skycell/endpoint.env
        if [ -r "$f" ]; then
            u=$(sed -n "s/^base_url=//p" "$f"); k=$(sed -n "s/^api_key=//p" "$f")
            p=${u#http://*:}; p=${p%%/*}
            c=$(curl -s -m 5 -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $k" "$u/models")
            if [ "$c" = 200 ]; then st=up; else st="down (HTTP $c)"; fi
            printf "  %-12s %-5s %s\n" skycell "$p" "$st"
        fi' 2>/dev/null || true
}

# --- starting the supervised services --------------------------------------
# WHY THIS EXISTS AT ALL.  Both kits declare their service as a `setup.startup`
# background command, and every comment in them assumes that a stop/start cycle
# re-runs it -- kits/desktop/spec.yaml says so in as many words ("Nothing
# re-applies a desired state after a stop/start cycle in this platform, so the
# desired state has to be always on").  That held on sbx 0.43.0.  It does not on
# 0.45.1: measured on an idle sandbox, BOTH `sbx exec <name> true` and
# `sbx run -d --name <name>` bring the container back with a fresh PID 1 and
# never dispatch the startup commands -- the sandbox comes up carrying tini,
# `sleep infinity` and dockerd, and nothing else.  The upgrade that did it also
# killed every running container on the way through (sandboxd took a SIGTERM
# mid-session and the new daemon logged "found no task and container is not
# running" for each sandbox), so the first symptom is a sandbox that says
# `running` with all five services down.
#
# So this re-applies the desired state by hand.  When sbx starts dispatching
# startup commands again, `svcs` becomes a no-op that prints "already running"
# -- which is exactly what it should print, so nothing here needs unwinding.
#
# TWO GUARDS, BECAUSE THERE ARE TWO WAYS TO GET THIS WRONG.  A second
# supervisor is worse than none: both scripts are `while true` restart loops, so
# the loser of the race for the port respawns forever and neither log ever
# settles.  The process check catches a supervisor that is alive but mid-backoff
# with its port closed; the port check catches a port held by something that is
# not a supervisor at all (a hand-run `jupyter lab`), which is the one case
# where doing nothing and saying so beats starting anything.
#
# WHY THE pgrep PATTERN IS BUILT FROM A VARIABLE AND NEVER SPELLED OUT.  The
# whole script below is one argument to `bash -lc`, so anything written into it
# literally is in this shell's own command line, and `pgrep -f` then finds
# ITSELF -- the same trap burp-start.sh documents for its own double-start
# guard.  Measured in a live sandbox, hunting the one real supervisor (pid 650):
#
#   script=$HOME/bin/$svc-svc.sh; pgrep -f "$script"   ->  650
#   pgrep -f "/home/agent/bin/jupyter-svc.sh"          ->  650 827 830
#
# where 827 is the shell itself and 830 the subshell of the `$(...)` it ran in.
# Building the path from $svc keeps it out of argv, which is what makes the
# match clean; note that the literal spelling is not rescued by dropping $$
# either, because that subshell carries the same cmdline and a different pid.
# The `grep -vx "$$"` below is therefore insurance and not the mechanism -- it
# is what stops this turning into a double-start bug the day someone
# "simplifies" the loop by interpolating the two paths on the host side.
#
# WHY NO ENVIRONMENT IS PASSED.  jupyter-svc.sh reads WORKSPACE_DIR to find the
# notebook root and would silently fall back to the unrelated image directory
# /home/agent/workspace without it.  It does not need to be set here: sbx puts
# it in the sandbox environment, so an `sbx exec` login shell already has it
# (measured -- the restarted JupyterLab reports root_dir=<the workspace mount>).
# Do not "fix" this by hard-coding a path.
#
# The logs are the one thing that is better than what the dispatcher did with
# them: it ran these scripts with their output going nowhere, so a supervisor
# announcing WHY it kept restarting announced it to no one.
start_services() {
    sbx exec "$NAME" bash -lc '
        LOGDIR=$HOME/.local/state/sbx-kits
        mkdir -p "$LOGDIR"
        port_open() { timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$1" 2>/dev/null; }
        waitfor=""
        # The script being present IS the test for "this kit is installed in
        # this sandbox" -- the host-side --kits list describes what `up` was
        # asked for, which is not necessarily what this sandbox was built with.
        for spec in jupyter:8888 desktop:5900; do
            svc=${spec%%:*}; port=${spec##*:}
            script=$HOME/bin/$svc-svc.sh
            [ -x "$script" ] || continue
            pid=$(pgrep -f "$script" 2>/dev/null | grep -vx "$$" | head -1)
            if [ -n "$pid" ]; then
                printf "  %-10s supervisor already running (pid %s)\n" "$svc" "$pid"
            elif port_open "$port"; then
                printf "  %-10s port %s is held by something that is not the supervisor; left alone\n" "$svc" "$port"
            else
                setsid nohup "$script" >>"$LOGDIR/$svc-svc.log" 2>&1 </dev/null &
                printf "  %-10s started; log %s\n" "$svc" "$LOGDIR/$svc-svc.log"
                waitfor="$waitfor $port"
            fi
        done
        # Wait for what we just started before the table below is printed,
        # rather than reporting a JupyterLab that is merely still importing as
        # down.  Xvnc answers in about a second, JupyterLab in ten or so; 30s is
        # the ceiling, and passing it is a real failure worth seeing as "down".
        for _ in $(seq 1 60); do
            pending=""
            for port in $waitfor; do port_open "$port" || pending="$pending $port"; done
            [ -z "$pending" ] && break
            sleep 0.5
        done
        # Burp is on demand by design (a 2-4GB JVM most sessions do not want),
        # so its two ports being down is not a fault -- but it is the obvious
        # thing to wonder about when reading the table, so name it.
        if [ -x "$HOME/bin/burp-start.sh" ] && ! port_open 8080; then
            printf "  %-10s on demand, not supervised: sbx-kits burp %s\n" "burp" "$1"
        fi' sbx-kits "$NAME" 2>/dev/null || true
    echo
    health
}

# --- skycell: the team's LLM server, through this machine's tunnel -----------
# kits/skycell holds the part that runs inside; this is the part that has to
# happen on the host, at the time, and so cannot be in a kit.  A skycell
# control center publishes its ssh tunnel on the host's loopback and exports
# what it serves to ${SKYCELL_EXPORT:-~/.config/skycell}: endpoint.env
# (base_url model ctx think temperature top_p top_k, optional embed_base_url)
# and key.  The same variable and default the control center itself uses, so
# there is nothing to configure here.
#
#   THE PORT.  Egress is default-deny, and a kit's allowlist is static and read
#   at create -- but the port is per person and can change under a running
#   sandbox.  So it is a per-sandbox rule, and the name that rule needs is not
#   the one in the URL: the sandbox reaches the host as host.docker.internal,
#   and the proxy rewrites that to localhost BEFORE matching.  Measured on sbx
#   0.45.1: allowing host.docker.internal:18000 still gets "Blocked by network
#   policy: domain localhost:18000"; allowing localhost:18000 works.
#
#   THE KEY.  It never enters the sandbox.  `sbx secret set-custom` stores a
#   command that reads the key file ON THE HOST, and the proxy swaps a fixed
#   placeholder for its output in requests to the named host.  Measured: the
#   secret has to be bound to localhost, not host.docker.internal (the same
#   rewrite); it works over plain http; and it is re-read per request, so a
#   key that changes when the cell does is picked up with nothing re-run.
#
#   THE DESCRIPTION.  endpoint.env names 127.0.0.1, which inside the sandbox is
#   the sandbox.  It is copied in to the same path, ~/.config/skycell/
#   endpoint.env, with the URLs rewritten to host.docker.internal and api_key=
#   set to the placeholder; kits/skycell's skycell-opencode then makes it
#   opencode's provider.
#
# `sbx rm` takes the rule and the secret with the sandbox.  A rule for a port
# you have since moved off is left behind: it allows a port nothing listens on.
SKYCELL_DIR="${SKYCELL_EXPORT:-$HOME/.config/skycell}"
SKYCELL_PLACEHOLDER="sbx-kits-skycell-key-via-proxy"

# Sets LP to the port of a host-loopback http URL, or dies.  Sets a variable
# rather than printing, because `p=$(f)` with a die inside f only exits the
# $(...) subshell.
loopback_port() {   # $1 key  $2 url  $3 file
    case "$2" in
        http://127.0.0.1:*/*|http://localhost:*/*) ;;
        *) die "$1=$2 in $3: only http://127.0.0.1:PORT/... is handled -- a tunnel on this machine's loopback" ;;
    esac
    LP="${2#http://*:}"; LP="${LP%%/*}"
    case "$LP" in ''|*[!0-9]*) die "$1=$2 in $3: no port in it" ;; esac
}

skycell_connect() {
    local ep="$SKYCELL_DIR/endpoint.env" key="$SKYCELL_DIR/key" base embed model ports p out code tmp verified=1
    [ -r "$ep" ] || die "no $ep -- attach the control center to a cell first: ./cc cell up"
    [ -s "$key" ] || die "no key at $key"
    base="$(sed -n 's/^base_url=//p' "$ep")"
    embed="$(sed -n 's/^embed_base_url=//p' "$ep")"
    model="$(sed -n 's/^model=//p' "$ep")"
    [ -n "$base" ] || die "no base_url in $ep"
    [ -n "$model" ] || die "no model in $ep"
    loopback_port base_url "$base" "$ep"; ports="$LP"; local chat_port="$LP"
    if [ -n "$embed" ]; then loopback_port embed_base_url "$embed" "$ep"; ports="$ports $LP"; fi

    # A cell that has idled out is the normal case between sessions, and
    # nothing below needs it: the rule and the key swap are about the port and
    # the key file, the opencode config about endpoint.env -- the last cell's,
    # kept until the control center learns that cell is gone.  So set up
    # anyway, and skip only the one check that needs a live server, saying so.
    # The next cell usually serves the same profile on the same port, and the
    # proxy re-reads the key per request, so it then works with nothing re-run;
    # a different model needs `sbx-kits skycell` again.
    code="$(curl -s -m 5 -o /dev/null -w '%{http_code}' "${base%/v1}/health" || true)"
    if [ "$code" != 200 ]; then
        verified=0
        echo "sbx-kits: WARNING: nothing healthy at ${base%/v1}/health on this machine (HTTP $code) -- setting up from $ep without checking it through the sandbox"
    fi

    for p in $ports; do
        if ! sbx policy check network --sandbox "$NAME" "localhost:$p" >/dev/null 2>&1; then
            out="$(sbx policy allow network --sandbox "$NAME" "localhost:$p" 2>&1)" \
                || die "could not allow localhost:$p for $NAME: $out"
        fi
    done
    out="$(sbx secret set-custom --sandbox "$NAME" --host localhost \
               --placeholder "$SKYCELL_PLACEHOLDER" --command "cat $(printf '%q' "$key")" 2>&1)" \
        || die "could not store the key swap for $NAME: $out"

    tmp="$(mktemp)"
    sed -E -e 's#^(base_url|embed_base_url)=http://(127\.0\.0\.1|localhost):#\1=http://host.docker.internal:#' \
           -e '/^api_key=/d' "$ep" > "$tmp"
    printf 'api_key=%s\n' "$SKYCELL_PLACEHOLDER" >> "$tmp"
    sbx exec -i "$NAME" sh -c 'mkdir -p "$HOME/.config/skycell" && cat > "$HOME/.config/skycell/endpoint.env"' < "$tmp" \
        || { rm -f "$tmp"; die "could not write endpoint.env into $NAME"; }
    rm -f "$tmp"

    # From inside, through the proxy, with the placeholder: the path opencode
    # takes.  Each failure has one cause, so say which.
    [ "$verified" = 1 ] || ports=""
    for p in $ports; do
        code="$(sbx exec "$NAME" curl -s -m 20 -o /dev/null -w '%{http_code}' \
                    -H "Authorization: Bearer $SKYCELL_PLACEHOLDER" "http://host.docker.internal:$p/v1/models" || true)"
        case "$code" in
            200) ;;
            403) die "$NAME: the proxy blocks localhost:$p (sbx policy check network --sandbox $NAME localhost:$p)" ;;
            401) die "$NAME: port $p answers but refuses the key -- $key is not the cell's key, or the proxy did not swap it in (sbx secret ls)" ;;
            *)   die "$NAME: port $p via host.docker.internal: HTTP ${code:-none}" ;;
        esac
    done

    if sbx exec "$NAME" sh -c 'command -v opencode >/dev/null && test -x "$HOME/bin/skycell-opencode"'; then
        sbx exec "$NAME" /home/agent/bin/skycell-opencode || die "skycell-opencode failed in $NAME"
        out="$(sbx exec "$NAME" opencode models skycell 2>&1 || true)"
        case "$out" in
            *"skycell/$model"*) ;;
            *) die "opencode in $NAME does not list skycell/$model: $out" ;;
        esac
    else
        echo "sbx-kits: no opencode in $NAME; ~/.config/skycell/endpoint.env is there for other tools"
    fi
    if [ "$verified" = 1 ]; then
        echo "sbx-kits: $NAME -> skycell/$model on this machine's port $chat_port, key swapped in by the proxy"
    else
        echo "sbx-kits: $NAME -> skycell/$model on this machine's port $chat_port, NOT verified (no cell answering)."
        echo "  After ./cc cell up: sbx-kits status $NAME shows it; if the cell serves another model, sbx-kits skycell $NAME"
    fi
}

case "$CMD" in
up)
    sandbox_exists && die "sandbox '$NAME' already exists and mounts this workspace.
  sbx-kits status $NAME    what is running
  sbx-kits urls $NAME      its URLs and token
  sbx-kits destroy $NAME   remove it first if you want a fresh one"

    KIT_ARGS=()
    MOUNTS=()
    for k in ${KITS//,/ }; do
        [ -d "$REPO/kits/$k" ] || die "no kit at $REPO/kits/$k"
        KIT_ARGS+=(--kit "$REPO/kits/$k")
    done

    if has_kit burp; then
        # Fail here, with the fix, rather than letting burp-start.sh discover it
        # after a five-minute create.
        if [ ! -f "$BURP_ROOT/dist/burp-installer.sh" ] && [ ! -f "$BURP_ROOT/dist/burpsuite_pro.jar" ]; then
            die "no Burp staged in $BURP_ROOT/dist -- run:
    $REPO/kits/burp/stage-burp.sh --installer /path/to/burpsuite_linux_arm64_*.sh
  (or drop 'burp' from --kits)"
        fi
        # ONE MOUNT, READ-ONLY, AND NO SECOND WRITABLE ONE.  $BURP_ROOT/state
        # used to be mounted read-write here, by every sandbox at once: they
        # shared one project.burp (so a new sandbox opened the last
        # engagement's proxy history), one preferences store, and one writable
        # ~950MB Burp installation that all of them executed. Everything Burp
        # writes is container-local now; what has to outlive a recreate is
        # copied in from this read-only mount at create.
        MOUNTS+=("$BURP_ROOT/dist:ro")
        # The same path again, because a kit cannot read the mount table.
        KIT_ARGS+=(--kit-arg "sbx-burp.dist=$BURP_ROOT/dist")
    fi

    if has_token_kit; then
        load_token
        KIT_ARGS+=(--kit-arg "token=$TOKEN")
    fi
    # Namespaced, unlike token=: jupyter_mcp_pkg is declared by sbx-jupyter alone, and
    # an unqualified --kit-arg is offered to every kit in the composition.
    # Skipped entirely when empty so the spec's own default stays the default.
    if [ -n "$JUPYTER_MCP_PKG" ] && has_kit jupyter; then
        KIT_ARGS+=(--kit-arg "sbx-jupyter.jupyter_mcp_pkg=$JUPYTER_MCP_PKG")
    fi
    if has_kit burp; then
        [ -n "$BURP_MCP_SRC" ] && KIT_ARGS+=(--kit-arg "sbx-burp.burp_mcp_src=$BURP_MCP_SRC")
        [ -n "$BURP_MCP_PKG" ] && KIT_ARGS+=(--kit-arg "sbx-burp.burp_mcp_pkg=$BURP_MCP_PKG")
    fi
    if [ -n "$PLAYWRIGHT_MCP_PKG" ] && has_kit browser; then
        KIT_ARGS+=(--kit-arg "sbx-browser.playwright_mcp_pkg=$PLAYWRIGHT_MCP_PKG")
    fi

    PUBLISH=()
    if has_kit jupyter; then
        PORT_JUPYTER=$(pick_port "$PORT_JUPYTER")
        PUBLISH+=(-p "$PORT_JUPYTER:8888")
    fi
    if has_kit desktop; then
        PORT_NOVNC=$(pick_port "$PORT_NOVNC")
        PUBLISH+=(-p "$PORT_NOVNC:6080")
    fi
    if has_kit burp; then
        PORT_BURP=$(pick_port "$PORT_BURP")
        PUBLISH+=(-p "$PORT_BURP:8080")
    fi

    # --detached at CREATE is the auto-stop fix: without it the sandbox stops 30
    # seconds after the last session disconnects, which kills anything you are
    # using from a browser.
    # "${MOUNTS[@]+...}" RATHER THAN "${MOUNTS[@]}".  MOUNTS is only populated by
    # the burp kit, and under `set -u` bash treats an unset-or-empty array
    # expansion as an unbound variable -- so ANY invocation without that kit
    # (`--kits desktop`, the very path someone using only this repo's desktop
    # would take) died with "MOUNTS[@]: unbound variable" before printing
    # anything useful.  The +alternate form expands to nothing when the array is
    # empty instead of erroring.  KIT_ARGS cannot be empty (every sandbox has a
    # kit), so it is left plain; PUBLISH can, and gets the same treatment below.
    CMDLINE=(sbx run --detached claude --name "$NAME" "$WORKSPACE"
             ${MOUNTS[@]+"${MOUNTS[@]}"}
             "${KIT_ARGS[@]}" -m "$MEMORY")
    [ -n "$CPUS" ] && CMDLINE+=(--cpus "$CPUS")
    # +alternate for the same reason as MOUNTS: a sandbox of only kits/opencode
    # publishes nothing, and an empty array is unbound under set -u in bash 3.2.
    CMDLINE+=(${PUBLISH[@]+"${PUBLISH[@]}"})

    if [ "$DRY_RUN" = 1 ]; then printf '%q ' "${CMDLINE[@]}"; echo; exit 0; fi

    echo "sbx-kits: creating '$NAME' with kits: $KITS"
    "${CMDLINE[@]}"
    # Not fatal here: the sandbox exists either way, and a cell that is not
    # up yet is the normal case.  The subshell is what lets die stop only this.
    if has_kit skycell; then
        ( skycell_connect ) || echo "sbx-kits: skycell NOT connected (above) -- once the cell is up: sbx-kits skycell $NAME"
    fi
    print_urls
    if has_kit burp; then
        cat <<EOF
Burp does not start with the sandbox:

    sbx exec -it $NAME /home/agent/bin/burp-start.sh

Attached, because Burp asks things. If no prefs.xml was staged, its EULA and
licence prompts are a console conversation on that terminal -- and answering
them spends an activation, so harvest the answers back to the host afterwards:

    $REPO/kits/burp/stage-burp.sh --harvest $NAME

Then it asks, on the DESKTOP, which project to open. Nothing binds port 8080
until you choose. This sandbox's Burp state is its own: no project history,
preferences or installation are shared with any other sandbox.
EOF
    fi
    ;;

urls)
    require_sandbox
    print_urls
    ;;

skycell)
    require_sandbox
    skycell_connect
    ;;

status)
    require_sandbox
    sbx ls 2>/dev/null | awk -v n="$NAME" 'NR==1 || $1==n'
    echo
    health
    ;;

# Idempotent by design, so it is safe to run when unsure: it reports what was
# already up instead of stacking a second supervisor on it.
svcs)
    require_sandbox
    start_services
    ;;

shell)   require_sandbox; exec sbx exec -it "$NAME" bash -l ;;
# ATTACHED, NOT DETACHED, and that is the whole reason this is a subcommand
# rather than something `up` does for you. Burp's first run against a fresh
# preferences store prints the EULA and blocks on stdin; started without a
# terminal it reads EOF and exits, leaving 70KB of licence text in burp.log and
# nothing on the desktop. burp-start.sh detects that case and refuses, but only
# `-it` makes the accepting possible. Later starts return as soon as Burp is up
# and asking which project to open -- that answer is given on the desktop.
burp)    require_sandbox; exec sbx exec -it "$NAME" /home/agent/bin/burp-start.sh ;;
# `sbx exec <name> true` starts a stopped sandbox without spawning the agent TUI.
# It does NOT bring the services back -- see start_services for what changed in
# sbx and why the desired state now has to be re-applied from out here -- so
# waking is two steps, and `exec` is gone from the first one to allow a second.
wake)
    require_sandbox
    sbx exec "$NAME" true
    start_services
    ;;
down)    exec sbx stop "$NAME" ;;
destroy)
    require_sandbox
    # THIS DESTROYS BURP'S STATE, and the prompt has to say so now.  It used to
    # promise the opposite, truthfully: the project file, preferences and
    # installation lived on a host mount that `sbx rm` could not reach. They are
    # inside the sandbox now -- which is what stops one engagement's proxy
    # history turning up in the next sandbox -- so removing it removes them.
    # Only $BURP_ROOT/dist, staged on the host and mounted read-only, survives.
    printf "Remove sandbox '%s'?
  Burp's project file(s), preferences and installation INSIDE it go too.
  Host-staged %s/dist (Burp, licence key, prefs.xml) is NOT touched.
  [y/N] " "$NAME" "$BURP_ROOT"
    # -f because THIS prompt is the confirmation.  `sbx rm` without it asks its
    # own "This cannot be undone" question, so the user answers twice for one
    # decision -- and the second prompt is the less informative of the two: it
    # cannot say what is about to be lost.  Keep the prompt that says something,
    # suppress the one that does not.
    read -r a; case "$a" in y|Y) sbx rm -f "$NAME" ;; *) echo "aborted" ;; esac
    ;;

*) die "unknown command: $CMD (try --help)" ;;
esac
