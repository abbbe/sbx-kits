{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jupyter": {
      "type": "local",
      "command": ["/home/agent/bin/jupyter-mcp.sh"],
      "enabled": true
    },
    "burp": {
      "type": "local",
      "command": ["/home/agent/bin/burp-mcp.sh"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["/home/agent/bin/playwright-mcp.sh"],
      "environment": {
        "BROWSER_MCP_PROFILE": "/home/agent/.local/state/browser/opencode-profile"
      },
      "enabled": true
    }
  }
}
