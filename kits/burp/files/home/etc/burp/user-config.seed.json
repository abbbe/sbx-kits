{
  "user_options": {
    "connections": {
      "upstream_proxy": {
        "servers": [
          {
            "enabled": true,
            "destination_host": "*",
            "proxy_host": "@PROXY_HOST@",
            "proxy_port": 0,
            "auth_type": "none"
          }
        ]
      }
    },
    "extender": {
      "extensions": []
    },
    "misc": {
      "enable_proxy_interception_at_startup": "never"
    }
  }
}
